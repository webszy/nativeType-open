# Copy to .env.development.local and set a separate HTTPS local/test Worker.
# Missing/invalid development configuration disables reporting. Production hosts are rejected.
WXT_ANALYTICS_API_BASE_URL=
# Optional developer self-test API base. HTTPS, or HTTP loopback for local simulation only.
# No signing secret or permanent API token belongs in any WXT variable.
WXT_POLISH_API_BASE_URL=
# Optional full AI Rewrite URL, e.g. http://127.0.0.1:8787/api/v1/polish
WXT_POLISH_API_URL=
